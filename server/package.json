{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "description": "ATOM API server (Express + Socket.IO), run by iisnode at /Atom",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "migrate": "node db/migrate.js",
    "seed:dev": "node db/seeds/001_dev_users.js",
    "sync:idarah": "node ../sync/run-idarah-sync.js",
    "sync:occupancy": "node ../sync/run-occupancy-sync.js",
    "sync:items": "node ../sync/run-items-sync.js",
    "import:employees": "node ../sync/import-employee-ids.js",
    "check": "node scripts/check.js"
  },
  "engines": {
    "node": ">=24"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  },
  "nodemonConfig": {
    "watch": [
      ".",
      "../shared",
      "../.env"
    ],
    "ext": "js,json,sql"
  },
  "license": "MIT",
  "dependencies": {
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mssql": "^12.7.11",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "openai": "^7.43.0",
    "pdfmake": "^0.3.12",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
