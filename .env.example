# ATOM environment — copy to .env (project root) and fill in.
# Never commit .env. Values here are placeholders only.

# --- App ---
NODE_ENV=development
PORT=3000
# Must be exactly /Atom
BASE_PATH=/Atom
# Client address used in email links. Dev: http://localhost:5173/Atom · Prod: https://marol.jameasaifiyah.edu/Atom
APP_URL=http://localhost:5173/Atom
# live = eJamaat SOAP. mock = seeded ITS numbers, dev/tests only (refused in production).
AUTH_MODE=live

# --- Session (JWT) ---
# Long random string, at least 32 characters.
SESSION_SECRET=
JWT_EXPIRES_IN=8h

# --- PostgreSQL (ATOM database) ---
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=atom
PG_USER=atom
PG_PASSWORD=

# --- SQL Server (read-only; employee-ID import from Login_Master) ---
MSSQL_SERVER=
MSSQL_PORT=1433
MSSQL_DATABASE=Jameasaifiyah
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERT=true
# Support Log item lists (Item_Master / Main_Item_Master), same server and login as above
SUPPORTLOG_DB=SupportLog_New

# --- eJamaat SOAP (server-side only) ---
# The .asmx address, must be https (a trailing ?wsdl is fine — it is stripped; the WSDL is never downloaded)
EJAMAAT_SOAP_URL=
EJAMAAT_APP_KEY=
EJAMAAT_TIMEOUT_MS=10000

# --- SMTP (password reset, notifications) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- OpenAI (server-side only) ---
# Model, temperature, GPT on/off and token limits are set in ATOM: FAQs & AI → AI settings.
OPENAI_API_KEY=
OPENAI_TIMEOUT_MS=15000
# Days/months for token limits start at midnight here
APP_TIME_ZONE=Asia/Kolkata

# --- Room occupancy sheet (who sits where) ---
# Google Sheet shared "Anyone with the link can view". ID = the long part of the sheet URL.
OCCUPANCY_SHEET_ID=
# Sheet tabs to read, comma separated
OCCUPANCY_SHEET_TABS=ADMIN BLDG

# --- Web Push (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# --- Files ---
# Absolute path OUTSIDE the web root, e.g. D:\ATOM-data\attachments
ATTACHMENT_DIR=
