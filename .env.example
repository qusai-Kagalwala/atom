# ATOM environment — copy to .env (project root) and fill in.
# Never commit .env. Values here are placeholders only.

# --- App ---
NODE_ENV=development
PORT=3000
# Must be exactly /Atom
BASE_PATH=/Atom
APP_URL=https://marol.jameasaifiyah.edu/Atom
# live = eJamaat SOAP. mock = seeded ITS numbers, dev/tests only (refused in production).
AUTH_MODE=live

# --- Session (JWT) ---
# Long random string, at least 32 characters.
SESSION_SECRET=
JWT_EXPIRES_IN=8h

# --- PostgreSQL (ATOM database) ---
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=atom
PG_USER=atom
PG_PASSWORD=

# --- SQL Server (read-only; employee-ID import from Login_Master) ---
MSSQL_SERVER=
MSSQL_PORT=1433
MSSQL_DATABASE=Jameasaifiyah
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERT=true

# --- eJamaat SOAP (server-side only) ---
# Full ?wsdl address, must be https
EJAMAAT_SOAP_URL=
EJAMAAT_APP_KEY=
EJAMAAT_TIMEOUT_MS=10000

# --- SMTP (password reset, notifications) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- OpenAI (server-side only) ---
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Web Push (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# --- Files ---
# Absolute path OUTSIDE the web root, e.g. D:\ATOM-data\attachments
ATTACHMENT_DIR=
