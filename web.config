<?xml version="1.0" encoding="utf-8"?>
<!--
  ATOM — IIS config. Lives at the project root (same level as server/ and client/).
  IIS app: /Atom (converted to Application, app pool "ATOM").
  Needs: iisnode (x64), URL Rewrite, WebSocket Protocol feature.
  After changes: appcmd recycle apppool /apppool.name:"ATOM"
-->
<configuration>
  <system.webServer>

    <!-- Node handler. iisnode matches by file name; rewrites below send API/socket traffic to server/server.js. -->
    <handlers>
      <remove name="WebDAV" />
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <!-- WebDAV blocks PUT / PATCH / DELETE. -->
    <modules>
      <remove name="WebDAVModule" />
    </modules>

    <!--
      One Node process (Socket.IO needs it). enableXFF passes the client IP (Express uses trust proxy).
      If node.exe is not on the app pool's PATH, set nodeProcessCommandLine="C:\Program Files\nodejs\node.exe".
    -->
    <iisnode
      node_env="production"
      nodeProcessCountPerApplication="1"
      enableXFF="true"
      loggingEnabled="true"
      logDirectory="iisnode"
      devErrorsEnabled="false"
      watchedFiles="web.config;*.js;.env" />

    <!-- iisnode handles the WebSocket upgrade itself. -->
    <webSocket enabled="false" />

    <!-- Let Express JSON errors through instead of IIS error pages. -->
    <httpErrors existingResponse="PassThrough" />

    <rewrite>
      <rules>
        <!-- 1. One exact spelling: /atom, /ATOM, … → /Atom -->
        <rule name="Atom canonical casing" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{URL}" pattern="^/Atom(/|$)" ignoreCase="false" negate="true" />
          </conditions>
          <action type="Redirect" url="/Atom/{R:0}" redirectType="Permanent" appendQueryString="true" />
        </rule>

        <!-- 2. API → Node -->
        <rule name="API to Node" stopProcessing="true">
          <match url="^api/" />
          <action type="Rewrite" url="server/server.js" />
        </rule>

        <!-- 3. Socket.IO → Node -->
        <rule name="Socket.IO to Node" stopProcessing="true">
          <match url="^socket\.io/" />
          <action type="Rewrite" url="server/server.js" />
        </rule>

        <!-- 4. Built assets -->
        <rule name="Client assets" stopProcessing="true">
          <match url="^assets/(.*)" />
          <action type="Rewrite" url="client/dist/assets/{R:1}" />
        </rule>

        <!-- 5. Self-hosted fonts -->
        <rule name="Client fonts" stopProcessing="true">
          <match url="^fonts/(.*)" />
          <action type="Rewrite" url="client/dist/fonts/{R:1}" />
        </rule>

        <!-- 6. Root statics (favicon, PWA manifest, service worker, icons) -->
        <rule name="Client root statics" stopProcessing="true">
          <match url="^(favicon\.svg|favicon\.ico|manifest\.webmanifest|sw\.js|robots\.txt|icons/.*)$" />
          <action type="Rewrite" url="client/dist/{R:1}" />
        </rule>

        <!-- 7. SPA fallback: everything else gets index.html (also hides server source paths) -->
        <rule name="SPA fallback" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="client/dist/index.html" />
        </rule>
      </rules>

      <outboundRules>
        <!-- Service worker must never be cached, or PWA updates get stuck. -->
        <rule name="No-cache service worker" preCondition="IsServiceWorker">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <action type="Rewrite" value="no-cache" />
        </rule>
        <preConditions>
          <preCondition name="IsServiceWorker">
            <add input="{REQUEST_URI}" pattern="/sw\.js$" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>

    <!-- MIME types: remove-then-add so a global registration never causes a duplicate-mimeMap error. -->
    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>

    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment=".git" />
          <add segment=".env" />
          <add segment="iisnode" />
          <add segment="attachments" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".env" allowed="false" />
        </fileExtensions>
        <!-- 12 MB: 10 MB uploads + multipart overhead -->
        <requestLimits maxAllowedContentLength="12582912" />
      </requestFiltering>
    </security>

  </system.webServer>
</configuration>
